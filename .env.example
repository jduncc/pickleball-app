# Copy this file to .env and fill in real values before running
# docker compose up. All of these are read by server/index.js, server/auth.js
# and server/db.js — see docker-compose.yml for how they're wired in.

# --- Public URL ---------------------------------------------------------
# The externally-visible https URL this app is reached at (through the
# Cloudflare Tunnel) — no trailing slash. Used to build the Google OAuth
# callback URL and the share links handed out for sessions.
PUBLIC_URL=https://pb.jonathanandamanda.com

# --- Google OAuth --------------------------------------------------------
# From Google Cloud Console (APIs & Services > Credentials > OAuth client
# ID, type "Web application"). Authorized redirect URI must be exactly
# ${PUBLIC_URL}/auth/google/callback, e.g.
# https://pb.jonathanandamanda.com/auth/google/callback
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme

# --- Sessions --------------------------------------------------------
# Long random string used to sign the session cookie. Generate one with:
#   openssl rand -base64 48
# Changing this logs everyone out. Keep it secret.
SESSION_SECRET=changeme

# --- Admin access --------------------------------------------------------
# Comma-separated list of Google account emails allowed into /admin. These
# accounts are also auto-allowed to sign in and use the app itself (no
# separate allowlist step needed for yourself). The FIRST email in this
# list is who any pre-existing single-tenant data gets assigned to on the
# one-time migration.
ADMIN_EMAILS=jonathan.desrochers@gmail.com

# --- Misc ------------------------------------------------------------
# Optional. The footer and GET /api/version already default to the version
# in server/package.json, so you only need this to override that with
# something else (e.g. a build or commit identifier). Leave unset normally.
#APP_VERSION=

# Required for secure (HTTPS-only) session cookies — only set this once
# the app is actually served over https (i.e. once the Cloudflare Tunnel
# is in front of it). Leave unset for local/plain-http testing.
NODE_ENV=production
